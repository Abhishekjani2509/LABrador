{
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.16",
    "@anthropic-ai/sdk": "^0.112.4",
    "@dotenvx/dotenvx": "^2.17.4",
    "eve": "^0.26.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "ultracite": "7.9.4"
  },
  "name": "mvp",
  "scripts": {
    "check": "ultracite check",
    "console": "bun scripts/console.ts",
    "deploy": "bun scripts/deploy.ts",
    "dev": "eve dev",
    "fix": "ultracite fix",
    "hyp-gen:programs": "cd managed/hypothesis-generator && .venv/bin/python -m hyp_gen.cli --graph fixtures/example_graph.json --profile valuation --dry-run --emit-programs runs/programs --frame fixtures/example_frame.json",
    "hyp-gen:setup": "cd managed/hypothesis-generator && python3 -m venv .venv && .venv/bin/pip install -e '.[dev]'",
    "hyp-gen:smoke": "bun managed/hypothesis-generator/fixtures/smoke.ts",
    "hyp-gen:test": "cd managed/hypothesis-generator && .venv/bin/python -m pytest -q",
    "pipeline": "bun managed/pipeline-observatory/pipeline.ts",
    "pipeline:health": "bun scripts/pipeline-health.ts",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "version": "0.1.0",
  "description": "Prototype agents in Claude Code, ship them on the Claude Developer Platform.",
  "private": true,
  "author": "Cyrus Nouroozi",
  "license": "MIT"
}
