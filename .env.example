# Claude API key — https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# --- druggability-dossier ---------------------------------------------------
# See managed/druggability-dossier/CREDENTIALS.md for the rotation procedure.
#
# Custom-tool handlers run in THIS process, not in the deployed sandbox, so
# everything below stays on the local machine and is uploaded by nothing.

# Paperclip API key. Authenticates the `paperclip` CLI non-interactively.
# Without it: the entire retrieved-precedent axis fails — paperclip_sql,
# paperclip_search, paperclip_grep, paperclip_read, and the Paperclip half of
# neighbour_precedent. The handlers raise rather than returning zero rows,
# because "no key" and "no precedent for this target" must never look alike.
PAPERCLIP_API_KEY=

# Absolute path to the `modal` binary. Required whenever `modal` is not on PATH.
# Without it: pocket_scan fails, which is the entire computed-tractability axis
# (fpocket/mdpocket exist only inside the Modal image). No local fallback.
# MODAL_BIN=

# Modal workspace profile. Defaults to `rafwiewiora`, which is the only
# workspace this pipeline may bill or read. A blank value is treated as unset.
# Any other profile is rejected by name — set MODAL_PROFILE_OVERRIDE to the same
# value to deliberately acknowledge a switch.
# Note: the Modal *token* is NOT set here; it lives in ~/.modal.toml.
# MODAL_PROFILE=

# Absolute path to `micromamba`. Defaults to ~/.local/bin/micromamba.
# Without it: cryptic_analysis, interface_analysis, disorder_scan and
# neighbour_precedent cannot run.
# MICROMAMBA_BIN=

# Absolute path to the `paperclip` binary. Defaults to ~/.local/bin/paperclip.
# Without it: same failures as a missing PAPERCLIP_API_KEY.
# PAPERCLIP_BIN=

# Conda env carrying gemmi + numpy for the local structure-analysis scripts.
# Defaults to `druggability`. Without a valid env: the gemmi/numpy scripts fail.
# DRUGGABILITY_ENV=

# Conda env for the disorder predictor. Defaults to DRUGGABILITY_ENV.
# DISORDER_ENV=

# Set to 1 ONLY to drive the Paperclip tools by hand on a machine with no Modal.
# Never set it for a real dossier run: it disables the preflight that catches a
# missing credential at second zero instead of forty minutes in.
# DOSSIER_SKIP_PREFLIGHT=
